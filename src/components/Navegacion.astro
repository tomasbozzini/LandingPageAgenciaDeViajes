---
import { agencia, secciones, linkWhatsapp, mensajes } from '../data/site';
const wa = linkWhatsapp(mensajes.general);
---

<header
  id="barra"
  class="fixed inset-x-0 top-0 z-50 transition-[background-color,border-color,backdrop-filter] duration-500"
  data-solida="no"
>
  <div class="lienzo">
    <div class="flex h-[72px] items-center justify-between gap-6">
      <!-- Marca -->
      <a href="#inicio" class="group flex items-center gap-3" aria-label={`${agencia.nombre}, inicio`}>
        <svg viewBox="0 0 32 32" class="h-8 w-8 shrink-0" aria-hidden="true">
          <circle cx="16" cy="16" r="14" fill="none" stroke="currentColor" stroke-width="1.25" opacity="0.55" />
          <ellipse
            cx="16"
            cy="16"
            rx="6"
            ry="14"
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"
            opacity="0.55"
          />
          <line x1="2" y1="16" x2="30" y2="16" stroke="currentColor" stroke-width="1.25" opacity="0.55" />
          <circle cx="16" cy="24.5" r="2.6" class="fill-oro-alto" />
        </svg>
        <span class="leading-none">
          <span class="display block text-[1.05rem] font-semibold tracking-tight text-hielo">{agencia.nombre}</span>
          <span class="block text-[0.68rem] font-medium tracking-wide text-hielo/70">{agencia.descriptor}</span>
        </span>
      </a>

      <!-- Secciones (desktop) -->
      <nav aria-label="Secciones" class="hidden lg:block">
        <ul class="flex items-center gap-1">
          {
            secciones.map((s) => (
              <li>
                <a
                  href={`#${s.id}`}
                  data-enlace={s.id}
                  class="relative block px-3 py-2 text-[0.86rem] font-medium text-hielo/70 transition-colors duration-300 hover:text-hielo aria-[current=true]:text-hielo"
                >
                  {s.rotulo}
                  <span
                    aria-hidden="true"
                    class="absolute inset-x-3 bottom-1 h-px origin-left scale-x-0 bg-oro-alto transition-transform duration-400 ease-[cubic-bezier(.2,.8,.2,1)]"
                    data-subrayado
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <a
          href={wa}
          target="_blank"
          rel="noopener"
          class="hidden items-center gap-2 rounded-full bg-cta px-5 py-2.5 text-[0.86rem] font-semibold text-noche transition-colors duration-300 hover:bg-cta-alto sm:inline-flex"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
            <path
              d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2Zm0 18.02h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.37c0-4.54 3.7-8.23 8.25-8.23a8.23 8.23 0 0 1 8.24 8.24c0 4.54-3.7 8.22-8.24 8.22Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.53.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.24-.01-.38.11-.5.11-.11.25-.29.37-.43.12-.15.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.16 0-.43.06-.65.31-.22.24-.85.83-.85 2.03s.87 2.35.99 2.51c.12.16 1.71 2.61 4.15 3.66.58.25 1.03.4 1.39.51.58.19 1.11.16 1.53.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z"
            ></path>
          </svg>
          Escribinos
        </a>

        <button
          type="button"
          id="menu-boton"
          class="inline-flex h-10 w-10 items-center justify-center rounded-full text-hielo lg:hidden"
          aria-expanded="false"
          aria-controls="menu-panel"
          aria-label="Abrir menú"
        >
          <span class="relative block h-3.5 w-5">
            <span
              class="absolute inset-x-0 top-0 h-px bg-current transition-transform duration-300"
              data-barra="uno"></span>
            <span
              class="absolute inset-x-0 top-1.5 h-px bg-current transition-opacity duration-300"
              data-barra="dos"></span>
            <span
              class="absolute inset-x-0 top-3 h-px bg-current transition-transform duration-300"
              data-barra="tres"></span>
          </span>
        </button>
      </div>
    </div>
  </div>

  <div class="h-px w-full bg-oro-alto/0 transition-colors duration-500" data-filo></div>
</header>

<!-- Panel móvil -->
<div
  id="menu-panel"
  class="fixed inset-0 z-40 hidden bg-noche/97 backdrop-blur-sm lg:hidden"
  data-abierto="no"
>
  <nav aria-label="Secciones" class="lienzo flex h-full flex-col justify-center">
    <ul class="space-y-1">
      {
        secciones.map((s, i) => (
          <li class="overflow-hidden">
            <a
              href={`#${s.id}`}
              data-enlace-movil
              style={`--i:${i}`}
              class="display block border-b border-oro-alto/14 py-4 text-[2rem] font-semibold text-hielo/85"
            >
              {s.rotulo}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href={wa}
      target="_blank"
      rel="noopener"
      class="mt-10 inline-flex w-fit items-center gap-2 rounded-full bg-cta px-6 py-3 font-semibold text-noche"
    >
      Escribinos por WhatsApp
    </a>
  </nav>
</div>

<style>
  #menu-panel[data-abierto='si'] a[data-enlace-movil] {
    animation: entrar-item 520ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: calc(var(--i) * 45ms + 60ms);
  }
  @keyframes entrar-item {
    from {
      opacity: 0;
      transform: translateY(0.6em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #menu-panel[data-abierto='si'] a[data-enlace-movil] {
      animation: none;
    }
  }
</style>

<script>
  const barra = document.getElementById('barra')!;
  const filo = barra.querySelector<HTMLElement>('[data-filo]')!;
  const enlaces = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-enlace]'));
  const boton = document.getElementById('menu-boton')!;
  const panel = document.getElementById('menu-panel')!;

  /* --- Fondo de la barra: transparente sobre el hero, sólida al bajar --- */
  const alSscrollear = () => {
    const solida = window.scrollY > 40;
    barra.dataset.solida = solida ? 'si' : 'no';
    barra.classList.toggle('bg-noche/88', solida);
    barra.classList.toggle('backdrop-blur-md', solida);
    filo.classList.toggle('bg-oro-alto/16', solida);
  };
  alSscrollear();
  window.addEventListener('scroll', alSscrollear, { passive: true });

  /* --- Sección activa --- */
  const marcar = (id: string) => {
    for (const a of enlaces) {
      const activo = a.dataset.enlace === id;
      a.setAttribute('aria-current', activo ? 'true' : 'false');
      const sub = a.querySelector<HTMLElement>('[data-subrayado]');
      if (sub) sub.style.transform = activo ? 'scaleX(1)' : 'scaleX(0)';
    }
  };

  const objetivos = enlaces
    .map((a) => document.getElementById(a.dataset.enlace!))
    .filter((el): el is HTMLElement => Boolean(el));

  if ('IntersectionObserver' in window && objetivos.length) {
    const visibles = new Map<string, number>();
    const obs = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) visibles.set(e.target.id, e.isIntersecting ? e.intersectionRatio : 0);
        let mejor = '';
        let max = 0;
        for (const [id, r] of visibles) {
          if (r > max) {
            max = r;
            mejor = id;
          }
        }
        if (mejor) marcar(mejor);
      },
      { rootMargin: '-72px 0px -45% 0px', threshold: [0, 0.15, 0.35, 0.6, 0.9] }
    );
    objetivos.forEach((s) => obs.observe(s));
  }

  /* --- Menú móvil --- */
  let abierto = false;
  const alternar = (forzar?: boolean) => {
    abierto = forzar ?? !abierto;
    panel.classList.toggle('hidden', !abierto);
    panel.dataset.abierto = abierto ? 'si' : 'no';
    boton.setAttribute('aria-expanded', String(abierto));
    boton.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
    document.documentElement.style.overflow = abierto ? 'hidden' : '';
    const uno = boton.querySelector<HTMLElement>('[data-barra="uno"]')!;
    const dos = boton.querySelector<HTMLElement>('[data-barra="dos"]')!;
    const tres = boton.querySelector<HTMLElement>('[data-barra="tres"]')!;
    uno.style.transform = abierto ? 'translateY(6px) rotate(45deg)' : '';
    dos.style.opacity = abierto ? '0' : '1';
    tres.style.transform = abierto ? 'translateY(-6px) rotate(-45deg)' : '';
  };

  boton.addEventListener('click', () => alternar());
  panel.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) alternar(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && abierto) {
      alternar(false);
      boton.focus();
    }
  });
</script>
