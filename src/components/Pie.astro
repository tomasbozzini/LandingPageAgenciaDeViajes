---
import { agencia, secciones } from '../data/site';
const anio = new Date().getFullYear();
---

<footer class="bg-noche pb-10 text-hielo">
  <div class="h-24 w-full bg-gradient-to-b from-marfil to-noche md:h-32" aria-hidden="true"></div>
  <div class="lienzo pt-6">
    <div class="grid gap-10 border-t border-oro-alto/16 pt-10 md:grid-cols-12">
      <div class="md:col-span-5">
        <div class="flex items-center gap-3">
          <svg viewBox="0 0 32 32" class="h-8 w-8" aria-hidden="true">
            <circle cx="16" cy="16" r="14" fill="none" stroke="currentColor" stroke-width="1.25" opacity="0.5" />
            <ellipse cx="16" cy="16" rx="6" ry="14" fill="none" stroke="currentColor" stroke-width="1.25" opacity="0.5" />
            <line x1="2" y1="16" x2="30" y2="16" stroke="currentColor" stroke-width="1.25" opacity="0.5" />
            <circle cx="16" cy="24.5" r="2.6" class="fill-oro-alto" />
          </svg>
          <span class="display text-[1.15rem] font-semibold">{agencia.nombre}</span>
        </div>
        <p class="mt-5 max-w-[38ch] text-[0.9rem] leading-relaxed text-hielo/70">
          Agencia de viajes habilitada, con oficina en {agencia.ciudad}. Trabajamos con salidas desde Buenos
          Aires y desde el interior de la provincia.
        </p>
        <p class="mt-4 text-[0.8rem] text-hielo/70">{agencia.legajo}</p>
      </div>

      <nav class="md:col-span-3" aria-label="Pie de página">
        <p class="text-[0.78rem] text-hielo/70">Secciones</p>
        <ul class="mt-4 space-y-2.5">
          {
            secciones.map((s) => (
              <li>
                <a
                  href={`#${s.id}`}
                  class="text-[0.9rem] text-hielo/70 transition-colors duration-300 hover:text-oro-alto"
                >
                  {s.rotulo}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="md:col-span-4">
        <p class="text-[0.78rem] text-hielo/70">Dónde encontrarnos</p>
        <ul class="mt-4 space-y-2.5 text-[0.9rem] text-hielo/70">
          <li>
            <a href={`mailto:${agencia.email}`} class="transition-colors duration-300 hover:text-oro-alto">
              {agencia.email}
            </a>
          </li>
          <li>
            <a
              href={`tel:${agencia.telefonoVisible.replace(/[^+\d]/g, '')}`}
              class="transition-colors duration-300 hover:text-oro-alto"
            >
              {agencia.telefonoVisible}
            </a>
          </li>
          <li>
            <a
              href={agencia.instagramUrl}
              target="_blank"
              rel="noopener"
              class="transition-colors duration-300 hover:text-oro-alto"
            >
              {agencia.instagram}
            </a>
          </li>
          <li class="text-hielo/70">{agencia.direccion}</li>
          <li class="text-hielo/70">{agencia.ciudad}</li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-4 border-t border-oro-alto/16 pt-6 text-[0.76rem] text-hielo/70 md:flex-row md:items-center md:justify-between"
    >
      <p>© {anio} {agencia.nombre}. Todos los derechos reservados.</p>
      <p class="max-w-[62ch] md:text-right">
        Los precios publicados son de referencia, por persona en base doble, y están sujetos a
        disponibilidad y a la cotización del día de la reserva.
      </p>
    </div>
  </div>
</footer>
