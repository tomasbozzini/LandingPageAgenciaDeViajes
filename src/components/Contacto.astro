---
import Encabezado from './Encabezado.astro';
import { agencia, linkWhatsapp, mensajes } from '../data/site';

const wa = linkWhatsapp(mensajes.general);

const datos = [
  { rotulo: 'Teléfono', valor: agencia.telefonoVisible, href: `tel:${agencia.telefonoVisible.replace(/[^+\d]/g, '')}` },
  { rotulo: 'Correo', valor: agencia.email, href: `mailto:${agencia.email}` },
  { rotulo: 'Oficina', valor: `${agencia.direccion}, ${agencia.ciudad}` },
  { rotulo: 'Atención', valor: agencia.horarios },
];

const paraCotizar = [
  'A dónde querés ir, o qué tipo de viaje tenés en la cabeza si todavía no lo definiste.',
  'Fechas aproximadas y cuántos días tenés.',
  'Cuántos son, y si viajan menores.',
  'Un presupuesto de referencia por persona. Con eso te decimos enseguida qué es realista.',
];
---

<section id="contacto" class="bg-marfil pb-24 text-tinta md:pb-32">
  <div class="lienzo pt-20 md:pt-28">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <Encabezado
          rotulo="Contacto"
          titulo="Escribinos y en el día"
          titulo2="tenés una respuesta."
          intro="No hay formulario ni bot. El mensaje le llega a un asesor, que te contesta con nombre y apellido y se queda con tu viaje hasta que volvés."
          tono="claro"
        />

        <a
          href={wa}
          target="_blank"
          rel="noopener"
          data-revelar
          style="--rev:1"
          class="mt-10 inline-flex items-center gap-3 rounded-full bg-cta-hondo px-8 py-4 text-[1rem] font-semibold text-marfil-alto transition-[background-color,transform] duration-300 hover:bg-cta active:scale-[0.985]"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
            <path
              d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2Zm0 18.02h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.37c0-4.54 3.7-8.23 8.25-8.23a8.23 8.23 0 0 1 8.24 8.24c0 4.54-3.7 8.22-8.24 8.22Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.53.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.24-.01-.38.11-.5.11-.11.25-.29.37-.43.12-.15.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.16 0-.43.06-.65.31-.22.24-.85.83-.85 2.03s.87 2.35.99 2.51c.12.16 1.71 2.61 4.15 3.66.58.25 1.03.4 1.39.51.58.19 1.11.16 1.53.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z"
            ></path>
          </svg>
          Abrir WhatsApp con el mensaje escrito
        </a>

        <p class="mt-4 max-w-[46ch] text-[0.85rem] leading-relaxed text-tinta/70">
          {agencia.guardia}
        </p>

        <dl class="mt-12 grid gap-x-8 gap-y-7 sm:grid-cols-2">
          {
            datos.map((d, i) => (
              <div class="border-t border-oro-hondo/38 pt-4" data-revelar style={`--rev:${i}`}>
                <dt class="text-[0.76rem] text-tinta/70">{d.rotulo}</dt>
                <dd class="mt-1 text-[0.98rem] leading-snug text-tinta/85">
                  {d.href ? (
                    <a href={d.href} class="transition-colors duration-300 hover:text-oro-hondo">
                      {d.valor}
                    </a>
                  ) : (
                    d.valor
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <aside class="lg:col-span-5">
        <div class="border border-oro-hondo/30 bg-marfil-alto p-7 md:p-9">
          <p class="rotulo text-oro-hondo">Para cotizarte rápido</p>
          <h3 class="mt-3 text-[1.5rem] font-semibold text-tinta">Contanos estas cuatro cosas</h3>
          <p class="mt-3 text-[0.92rem] leading-relaxed text-tinta/70">
            Con esto armamos un primer presupuesto real, no un rango de precios inventado.
          </p>

          <ol class="mt-7">
            {
              paraCotizar.map((p, i) => (
                <li class="grid grid-cols-[2rem_1fr] gap-3 border-t border-oro-hondo/30 py-4">
                  <span class="cifra display text-[1.05rem] font-semibold text-oro-hondo">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="text-[0.92rem] leading-snug text-tinta/80">{p}</span>
                </li>
              ))
            }
          </ol>

          <p class="mt-6 border-t border-oro-hondo/30 pt-5 text-[0.82rem] leading-relaxed text-tinta/70">
            Si ya tenés vuelos comprados por tu cuenta, decilo también: armamos solo la parte de tierra.
          </p>
        </div>
      </aside>
    </div>
  </div>
</section>
