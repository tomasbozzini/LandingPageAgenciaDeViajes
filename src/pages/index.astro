---
import Base from '../layouts/Base.astro';
import Navegacion from '../components/Navegacion.astro';
import Hero from '../components/Hero.astro';
import Encabezado from '../components/Encabezado.astro';
import Paquetes from '../components/Paquetes.astro';
import Vitrina from '../components/Vitrina.astro';
import Diferenciales from '../components/Diferenciales.astro';
import Contacto from '../components/Contacto.astro';
import Pie from '../components/Pie.astro';
import { agencia } from '../data/site';

const titulo = `${agencia.nombre} | Agencia de viajes en ${agencia.ciudad}`;
const descripcion = `${agencia.nombre} es una agencia de viajes que arma viajes a medida por Argentina y el mundo, con el desglose de precios a la vista y guardia por WhatsApp mientras viajás.`;

/* Datos estructurados (schema.org/TravelAgency). Sólo datos que el sitio
   ya muestra: la dirección es la ciudad, sin calle (no hay local). */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: agencia.nombre,
  url: new URL('/', Astro.site).href,
  description: descripcion,
  logo: new URL('/og-elisa-medici-viajes.jpg', Astro.site).href,
  image: new URL('/og-elisa-medici-viajes.jpg', Astro.site).href,
  telephone: `+${agencia.whatsapp}`,
  email: agencia.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: agencia.ciudad,
    addressRegion: agencia.provincia,
    addressCountry: agencia.pais,
  },
  areaServed: 'Argentina',
  sameAs: [agencia.instagramUrl],
};
---

<Base titulo={titulo} descripcion={descripcion}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Navegacion />

  <main>
    <!-- 01 — Bienvenida: sólo la marca -->
    <Hero />

    <!-- 02 — Paquetes: lo primero que aparece al bajar -->
    <section id="paquetes" class="bg-noche py-24 md:py-32">
      <div class="lienzo">
        <Encabezado
          rotulo="Paquetes"
          titulo="Los primeros viajes,"
          titulo2="en preparación."
          intro="Estamos armando los paquetes. Cada uno va a tener el día por día, qué entra y qué no, y el precio por persona a la vista."
        />
        <Paquetes />
      </div>
    </section>

    <!-- 03 — Vitrina: destinos y cifras, después de los paquetes -->
    <Vitrina />

    <!-- 04 — Cómo trabajamos (marfil, con transición degradada propia) -->
    <Diferenciales />

    <!-- 05 — Contacto (marfil, con transición degradada propia) -->
    <Contacto />
  </main>

  <Pie />
</Base>
